.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  background: #ffffff;
  box-shadow: 0 -4px 10px rgba(0,0,0,0.06);
  z-index: 1000;
}
.left, .center, .right { flex: 1; text-align: center; }
.left { text-align: left; }
.right { text-align: right; }
.btn {
  background: #d23f57;
  color: #fff;
  padding: 6px 14px;
  border-radius: 20px;
}

page { padding-bottom: 70px; }

