<view class="container">
  <block wx:if="{{loading && orders.length===0}}">
    <view class="skeleton">
      <block wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="card sk-card">
          <view class="sk-line" style="width:60%"></view>
          <view class="sk-line" style="width:40%"></view>
          <view class="sk-line" style="width:90%"></view>
        </view>
      </block>
    </view>
  </block>
  <block wx:elif="{{orders.length===0}}">
    <view class="empty">
      <image class="empty-img" src="/assets/empty.png" mode="widthFix"></image>
      <view class="empty-tips">暂无订单，去点单吧～</view>
    </view>
  </block>
  <block wx:else>
    <view class="filters card">
      <view class="tag {{statusFilter==='all'?'active':''}}" data-v="all" bindtap="setFilter">全部</view>
      <view class="tag {{statusFilter==='pending'?'active':''}}" data-v="pending" bindtap="setFilter">待处理</view>
      <view class="tag {{statusFilter==='done'?'active':''}}" data-v="done" bindtap="setFilter">已完成</view>
    </view>
    <block wx:for="{{orders}}" wx:key="_id">
      <view class="card" style="margin-bottom:10px;">
        <view style="display:flex;justify-content:space-between;">
          <text>订单号：{{item._id}}</text>
          <text class="status">{{item.status || 'pending'}}</text>
        </view>
        <view style="color:#888;margin:6px 0;">{{item.createdAtStr}}</view>
        <view>
          <block wx:for="{{item.items}}" wx:key="id">
            <view class="row" style="justify-content:space-between;margin:4px 0;">
              <text>{{item2.name}} x {{item2.count}}</text>
              <text>¥{{(item2.count*item2.price).toFixed(2)}}</text>
            </view>
          </block>
        </view>
        <view style="text-align:right;font-weight:600;margin-top:6px;">合计：¥{{item.totalPrice}}</view>
      </view>
    </block>
    <view wx:if="{{hasMore}}" class="loadmore" bindtap="loadMore">加载更多</view>
  </block>
</view>
