<view class="container" style="text-align:center;">
  <view class="card">
    <view style="font-size:22px;color:#16a34a;">下单成功</view>
    <view style="color:#888;margin-top:6px;">订单号：{{orderId}}</view>
  </view>
  <view style="margin-top:16px;display:flex;gap:8px;justify-content:center;">
    <button bindtap="goOrders">查看订单</button>
    <button type="primary" bindtap="goMenu">继续点单</button>
  </view>
</view>

