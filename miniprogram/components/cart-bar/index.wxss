.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  background: #ffffff;
  box-shadow: 0 -4px 10px rgba(0,0,0,0.06);
  z-index: 1000;
}
.left, .center, .right { flex: 1; text-align: center; }
.left { text-align: left; }
.right { text-align: right; }
.btn { background: #6B4A2B; color: #fff; padding: 6px 14px; border-radius: 20px; }
.btn:active { background: #836046; }

.cart-padding { padding-bottom: 70px; }

/* Bottom sheet styles (same as product page) */
.sheet-mask { position: fixed; left:0; right:0; top:0; bottom:0; background: rgba(0,0,0,0.35); z-index: 2000; display:flex; align-items:flex-end; }
.sheet-panel { background:#fff; border-top-left-radius: 16px; border-top-right-radius: 16px; width:100%; max-height: 70vh; padding: 12px; }
.sheet-header { display:flex; justify-content:space-between; align-items:center; font-weight:700; color:#2B2B2B; padding-bottom: 8px; border-bottom:1px solid #f3f3f3; }
.sheet-header .close { color:#6B4A2B; font-weight:600; }
.sheet-row { display:flex; justify-content:space-between; align-items:center; padding: 10px 0; border-bottom: 1px solid #f6f6f6; }
.sheet-row:last-child { border-bottom: none; }
.sheet-info .muted { color:#999; margin-left: 6px; }
.sheet-actions { display:flex; gap:10px; align-items:center; width: 50%; }
.sheet-actions .subtotal { margin-left:auto; color:#2B2B2B; font-weight:600; }
.sheet-empty { text-align:center; color:#999; padding: 16px 0; }
.left.clickable { cursor: pointer; }
.sheet-footer .ops{ margin-left:auto; display:flex; gap:8px; }
.btn-danger{ background:#d9534f; color:#fff; border-radius:16px; padding: 4px 10px; }
