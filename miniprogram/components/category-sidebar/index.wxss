.sidebar { width: 100%; height: 100%; background: #fff; border-right: 1px solid #eee; box-sizing: border-box; padding-bottom: 80rpx; }
.item { padding: 14px 12px; color: #2B2B2B; text-align: center; word-break: break-all; }
.item.active { background: #efe6d7; color: #6B4A2B; font-weight: 600; }
.bottom-gap { height: 100rpx; }
