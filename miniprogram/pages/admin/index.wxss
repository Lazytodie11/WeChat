.container { background:#FBF5EC; min-height:100vh; padding-bottom:20px; }
.card { background:#fff; border-radius: 14px; padding: 12px; margin: 10px; box-shadow: 0 10px 24px rgba(0,0,0,0.08); }
.row { display:flex; justify-content:space-between; align-items:center; padding:6px 0; color:#2B2B2B; }
.title { font-weight:700; color:#6B4A2B; margin-bottom:8px; }
.empty { color:#9c8a7a; text-align:center; padding:10px 0; }
.input { border:1px solid #F3E7D6; border-radius:8px; padding:8px; margin:8px 0; }
.btn-primary { background:#6B4A2B; color:#fff; border-radius:12px; }
.btn-danger { background:#d9534f; color:#fff; border-radius:12px; }
.tips { color:#9c8a7a; margin: 10px; font-size:12px; }

