<view class="container">
  <view class="nav">
    <view class="back" bindtap="goBack">返回</view>
    <view class="title">查看</view>
  </view>
  <view class="card">
    <view class="title">已选</view>
    <block wx:for="{{cart}}" wx:key="variantKey">
      <view class="row" style="margin:6px 0;align-items:center;">
        <view class="col">
          <text>{{item.name}}</text>
          <text wx:if="{{item.variantSize}}">（{{item.variantSize}}）</text>
          <text wx:if="{{item.optionName}}" style="color:#999;margin-left:6px;">口味：{{item.optionName}}</text>
          <view class="subline">{{ item.optionsDesc || '默认' }}</view>
        </view>
        <view class="row-actions">
          <button size="mini" bindtap="dec" data-id="{{item.id}}" data-size="{{item.variantSize}}" data-sig="{{item.optionsSignature||''}}">-</button>
          <text class="count">{{item.displayQty}}</text>
          <button size="mini" type="primary" bindtap="inc" data-id="{{item.id}}" data-size="{{item.variantSize}}" data-name="{{item.name}}" data-sig="{{item.optionsSignature||''}}">+</button>
        </view>
      </view>
    </block>
    <view class="note">仅供展示使用</view>
  </view>

  <button class="btn-primary" style="margin-top:16px;" bindtap="submitOrder" loading="{{submitting}}">完成展示</button>
</view>
