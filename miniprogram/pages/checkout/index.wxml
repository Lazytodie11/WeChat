<view class="container">
  <view class="nav">
    <view class="back" bindtap="goBack">返回</view>
    <view class="title">结算</view>
  </view>
  <view class="card">
    <view class="title">购物车</view>
    <block wx:for="{{cart}}" wx:key="variantKey">
      <view class="row" style="margin:6px 0;align-items:center;">
        <view class="col">
          <text>{{item.name}}</text>
          <text wx:if="{{item.variantSize}}">（{{item.variantSize}}）</text>
        </view>
        <view class="row-actions">
          <button size="mini" bindtap="dec" data-id="{{item.id}}" data-size="{{item.variantSize}}">-</button>
          <text class="count">{{item.displayQty}}</text>
          <button size="mini" type="primary" bindtap="inc" data-id="{{item.id}}" data-size="{{item.variantSize}}" data-name="{{item.name}}" data-price="{{item.price}}">+</button>
        </view>
        <view class="price">¥{{item.subtotal}}</view>
      </view>
    </block>
    <view class="row" style="justify-content:space-between;margin-top:8px;font-weight:600;">
      <view>合计</view>
      <view>¥{{summary.totalPrice}}</view>
    </view>
  </view>

  <view class="card" style="margin-top:12px;">
    <view class="title">联系方式</view>
    <view class="form">
      <view class="form-item">
        <text>姓名</text>
        <input placeholder="请输入姓名" bindinput="onInput" data-field="name" value="{{contact.name}}"/>
      </view>
      <view class="form-item">
        <text>手机</text>
        <input placeholder="用于联系取餐" type="number" bindinput="onInput" data-field="phone" value="{{contact.phone}}"/>
      </view>
      <view class="form-item">
        <text>备注</text>
        <input placeholder="口味/忌口等（可选）" bindinput="onInput" data-field="note" value="{{contact.note}}"/>
      </view>
    </view>
  </view>

  <button class="btn-primary" style="margin-top:16px;" bindtap="submitOrder" loading="{{submitting}}">提交订单</button>
</view>
