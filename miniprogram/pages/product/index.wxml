<view class="product-page">
  <view class="nav">
    <view class="back" bindtap="goBack">返回</view>
    <view class="title">商品详情</view>
  </view>
  <view class="gallery card">
    <swiper circular autoplay interval="3000" duration="500" indicator-dots wx:if="{{images.length>0}}">
      <block wx:for="{{images}}" wx:key="*this">
        <swiper-item>
          <image class="slide" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </block>
    </swiper>
    <image wx:else class="slide" src="/assets/p1.jpg" mode="aspectFill" />
  </view>

  <view class="card info">
    <view class="name">{{product.name}}</view>
    <view class="brief">{{product.brief}}</view>
    <view class="price-line">¥{{selectedVariant ? selectedVariant.price : (variants.length>0 ? variants[current].price : minPrice)}}</view>
  </view>

  <view class="card variants" wx:if="{{variants.length>0}}">
    <view class="v-title">可选尺寸</view>
    <view class="v-list">
      <block wx:for="{{variants}}" wx:key="size">
        <view class="v-item {{index===current?'active':''}}" bindtap="chooseVariant" data-idx="{{index}}">
          <text>{{item.size}}</text>
          <text>¥{{item.price}}</text>
        </view>
      </block>
    </view>
    <view class="selected clickable" wx:if="{{variants.length>0}}" bindtap="openSheet">
      <view>
        已选：{{selectedVariant ? selectedVariant.size : variants[current].size}} x {{count}}，单价 ¥{{selectedVariant ? selectedVariant.price : variants[current].price}}
      </view>
      <view class="arrow">管理</view>
    </view>
  </view>

  <view class="card options" wx:if="{{options && options.length}}">
    <view class="v-title">可选项</view>
    <view class="opt-list">
      <block wx:for="{{options}}" wx:key="name">
        <view class="opt-tag {{item.selected?'active':''}}" data-name="{{item.name}}" bindtap="toggleOption">{{item.name}}</view>
      </block>
    </view>
  </view>

  <view class="card actions">
    <view class="qty">
      <button size="mini" bindtap="dec">-</button>
      <text class="count">{{count}}</text>
      <button size="mini" type="primary" bindtap="inc">+ 加入</button>
    </view>
  </view>

  <!-- Bottom Sheet: Manage selected variants -->
  <view class="sheet-mask" wx:if="{{showSheet}}" bindtap="closeSheet">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-header">
        <text>当前已选</text>
        <text class="close" bindtap="closeSheet">完成</text>
      </view>
      <block wx:if="{{sheetItems.length}}">
        <block wx:for="{{sheetItems}}" wx:key="variantKey">
          <view class="sheet-row">
            <view class="sheet-info">
              <text>{{item.name}}</text>
              <text class="muted">（{{item.variantSize}}）</text>
            </view>
            <view class="sheet-actions">
              <button size="mini" bindtap="sheetDec" data-size="{{item.variantSize}}">-</button>
              <text class="count">{{item.count}}</text>
              <button size="mini" type="primary" bindtap="sheetInc" data-size="{{item.variantSize}}">+</button>
              <text class="subtotal">¥{{item.subtotal}}</text>
            </view>
          </view>
        </block>
        <view class="sheet-footer">
          <text>合计：¥{{sheetTotal}}</text>
          <view class="ops">
            <button size="mini" class="btn-plain" bindtap="clearCurrent">清空本商品</button>
            <button size="mini" class="btn-danger" bindtap="clearAll">清空全部</button>
          </view>
        </view>
      </block>
      <view wx:else class="sheet-empty">暂无已选</view>
    </view>
  </view>
</view>
