.product-page { background: #FBF5EC; min-height: 100vh; padding-bottom: 20px; padding-top: 88rpx; }
.nav{position: sticky; top:0; height:88rpx; background:#FBF5EC; display:flex; align-items:center; z-index:10}
.back{padding:0 24rpx; color:#6B4A2B}
.title{font-weight:700; color:#6B4A2B}
.gallery .slide { width: 100%; height: 220px; border-radius: 12px; }
.card { background: #fff; border-radius: 14px; padding: 12px; margin: 10px; box-shadow: 0 10px 24px rgba(0,0,0,0.08); }
.info .name { font-weight: 700; font-size: 18px; color: #2B2B2B; }
.info .brief { color: #6a6a6a; margin-top: 6px; }
.price-line { color: #6a6a6a; font-size: 13px; margin-top: 8px; }
.variants .v-title { font-weight: 700; margin-bottom: 8px; color: #2B2B2B; }
.v-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.v-item { border: 1px solid #F3E7D6; border-radius: 10px; padding: 10px; display: flex; justify-content: space-between; align-items: center; color: #6B4A2B; }
.v-item.active { background: #6B4A2B; color: #fff; border-color: #6B4A2B; }
.options .opt-list { display:flex; flex-wrap: wrap; gap: 8px; }
.options .opt-tag { border:1px solid #F3E7D6; color:#6B4A2B; border-radius: 16px; padding: 6px 10px; }
.options .opt-tag.active { background:#6B4A2B; color:#fff; border-color:#6B4A2B; }
.variants .selected { margin-top: 8px; color: #6B4A2B; font-size: 13px; }
.variants .selected.clickable { border: 1px solid #F3E7D6; border-radius: 10px; padding: 10px; display:flex; justify-content:space-between; align-items:center; }
.variants .selected .arrow { color:#6B4A2B; opacity: .8; }
.actions .qty { display:flex; justify-content:center; align-items:center; gap: 10px; }
.actions .count { width: 30px; text-align:center; }

/* Bottom sheet */
.sheet-mask { position: fixed; left:0; right:0; top:0; bottom:0; background: rgba(0,0,0,0.35); z-index: 2000; display:flex; align-items:flex-end; }
.sheet-panel { background:#fff; border-top-left-radius: 16px; border-top-right-radius: 16px; width:100%; max-height: 88vh; min-height: 46vh; padding: 16px; overflow-y: auto; }
.sheet-header { display:flex; justify-content:space-between; align-items:center; font-weight:700; color:#2B2B2B; padding-bottom: 8px; border-bottom:1px solid #f3f3f3; }
.sheet-header .close { color:#6B4A2B; font-weight:600; }
.sheet-row { display:flex; justify-content:space-between; align-items:flex-start; padding: 10px 0; border-bottom: 1px solid #f6f6f6; }
.sheet-row:last-child { border-bottom: none; }
.sheet-info { flex: 1; min-width: 0; display:flex; flex-direction: column; }
.sheet-info .muted { color:#999; margin-left: 6px; }
.sheet-info .options-desc { color:#9c8a7a; margin-top: 4px; white-space: normal; word-break: break-word; }
.sheet-actions { display:flex; gap:10px; align-items:center; margin-left:8px; }
.sheet-footer { display:flex; align-items:center; justify-content:space-between; padding-top:8px; color:#2B2B2B; }
.sheet-footer .note { color:#6a6a6a; font-size:12px; font-weight:400; }
.sheet-footer .ops{ margin-left:auto; display:flex; gap:8px; font-weight:400; }
.btn-plain{ background:#f6f1ea; color:#6B4A2B; border-radius:16px; padding: 4px 10px; }
.btn-danger{ background:#d9534f; color:#fff; border-radius:16px; padding: 4px 10px; }
.sheet-empty { text-align:center; color:#999; padding: 16px 0; }

/* fillings */
.card-title { color:#6B4A2B; font-weight:600; margin-bottom:16rpx; display:flex; align-items:center; gap:8rpx; }
.card-title .hint { color:#9c8a7a; font-size:24rpx; }
.chip-wrap { display:flex; flex-wrap:wrap; gap:16rpx; }
.chip { padding:10rpx 20rpx; border:1rpx solid #e6dacd; color:#6B4A2B; border-radius:999rpx; }
.chip--active { background:#f2e7dc; border-color:#6B4A2B; }
.chip--disabled { opacity: .5; }
.dev-flag { margin: 8px 12px; color:#b36b00; font-size: 12px; }
